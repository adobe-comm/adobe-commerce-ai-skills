<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="brainvire_erp_order_export" instance="Brainvire\ErpSync\Cron\ExportOrders" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <job name="brainvire_erp_export_retry" instance="Brainvire\ErpSync\Cron\RetryFailedExports" method="execute">
            <schedule>0 * * * *</schedule>
        </job>
    </group>
</config>
